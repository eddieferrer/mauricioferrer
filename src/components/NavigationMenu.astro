---
import Img from './Img.astro'
import logo from '../assets/images/logo.png'
import { getProjects, projectPath } from '../lib/site'

const projects = await getProjects()
const current = Astro.url.pathname
// Same classes Gridsome's <g-link> produced: "/" is active on every page,
// and the link to the current page also gets "active--exact".
const homeClass = current === '/' ? 'active--exact active' : 'active'
---

<nav class="navbar navbar-default">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target=".navbar-collapse">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a href="/" class={`navbar-brand ${homeClass}`}>
        <Img src={logo} alt="Mauricio Ferrer - Logo" eager />
      </a>
    </div>
    <div class="navbar-collapse collapse">
      <ul class="nav navbar-nav">
        <li class="active">
          <a href="/" class={homeClass}><span>HOME</span></a>
        </li>
        <li class="dropdown">
          <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"
            ><span>PROJECTS</span><span class="dropdown-icon"></span></a
          >
          <ul class="dropdown-menu animated zoomIn fast">
            {
              projects.map((p) => (
                <li>
                  <a
                    href={projectPath(p)}
                    class:list={['project-link', { 'active--exact active': current === projectPath(p) }]}
                  >
                    {p.data.menu_title}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li>
          <a href="/docs/Architect_M_Ferrer_CV.pdf" target="_blank"><span>RESUME / CV</span></a>
        </li>
      </ul>
    </div>
  </div>
</nav>
