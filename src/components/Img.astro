---
import type { ImageMetadata } from 'astro'
import { responsiveImage } from '../lib/images'

interface Props {
  src: ImageMetadata
  alt?: string
  eager?: boolean
}

const { src, alt = '', eager = false } = Astro.props
const img = await responsiveImage(src)
---

<img
  alt={alt}
  src={img.src}
  srcset={img.srcset}
  sizes={img.sizes}
  width={img.width}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
